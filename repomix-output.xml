function formatMatchDate(date: string): string {
  return new Intl.DateTimeFormat("en-IN", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(date));
}

function formatScore(
  score:
    | {
        runs?: number;
        wickets?: number;
        overs?: number;
      }
    | undefined
): string {
  if (!score) {
    return "Yet to bat";
  }

  const runs = score.runs ?? 0;
  const wickets = score.wickets ?? 0;
  const overs = score.overs ?? 0;

  if (
    runs === 0 &&
    wickets === 0 &&
    overs === 0
  ) {
    return "Yet to bat";
